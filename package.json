{
  "name": "gawa-admin",
  "version": "1.0.0",
  "private": true,
  "description": "GAWA Admin Portal - monolithic full-stack admin platform",
  "scripts": {
    "dev": "concurrently -n sv,cl -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch scripts/run-server.js development",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "start": "node scripts/run-server.js production",
    "test": "vitest run && jest",
    "test:server": "jest",
    "test:client": "vitest run",
    "test:watch": "vitest",
    "db:seed-roles": "node scripts/seed-team-roles.js",
    "account:ensure": "node scripts/ensure-team-account.js",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "@supabase/supabase-js": "^2.110.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^7.1.0",
    "lucide-react": "^1.17.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^2.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.7",
    "jest": "^30.5.2",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "vite": "^6.4.6",
    "vitest": "^4.1.12",
    "wrangler": "^4.162.0"
  },
  "overrides": {
    "body-parser": "^1.20.9",
    "proxy-addr": "^2.0.8",
    "qs": "^6.17.1",
    "ip-address": "^10.7.6",
    "shell-quote": "^1.12.0",
    "browserslist": "^4.29.5",
    "baseline-browser-mapping": "^2.11.36",
    "postcss": "^8.5.32",
    "source-map-js": "^1.2.2",
    "deepmerge": "^4.3.1",
    "js-yaml@^3.0.0": "^3.15.2",
    "nanoid@^3.0.0": "^3.3.20",
    "undici@^7.0.0": "^7.30.2",
    "brace-expansion@^1.0.0": "^1.1.22",
    "brace-expansion@^2.0.0": "^2.1.8",
    "minimatch@^9.0.0": "^11.0.8",
    "minimatch@^10.0.0": "^11.0.8",
    "glob": "^14.0.5"
  }
}
